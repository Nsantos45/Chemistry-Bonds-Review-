var A=document.getElementById("app"),pool,i,score,streak,best,hints,res,miss,locked,cur,opts,store={};
function sh(a){a=a.slice();for(var k=a.length-1;k>0;k--){var j=Math.floor(Math.random()*(k+1)),t=a[k];a[k]=a[j];a[j]=t}return a}
function ld(){try{store=JSON.parse(localStorage.getItem("ptsd")||"{}")}catch(e){store={}}}
function sv(){try{localStorage.setItem("ptsd",JSON.stringify(store))}catch(e){}}
function home(){
 var h='<h1>Periodic Table Showdown 🧪</h1><p class="sub">Pick a round, earn points, build streaks, and get a study plan at the end.</p><div class="tiles">';
 h+='<button class="tile wide" onclick="start(-1)"><b>🏆 Test Day Mode</b><small>15 mixed questions from everything'+(store.all?' · best '+store.all:'')+'</small></button>';
 T.forEach(function(t,k){h+='<button class="tile" onclick="start('+k+')"><b>'+t.e+' '+t.n+'</b><small>10 questions'+(store[k]?' · best '+store[k]:'')+'</small></button>'});
 A.innerHTML=h+'</div><p class="sub" style="margin-top:18px">Covalent bonding is crossed out on your review sheet, so it is not in this game.</p>';
}
function start(t){
 pool=t<0?sh(Q).slice(0,15):sh(Q.filter(function(x){return x[0]==t})).slice(0,10);
 mode=t;i=0;score=0;streak=0;hints=2;res={};miss=[];ask();
}
var mode;
function ask(){
 locked=false;cur=pool[i];opts=sh(cur[2].map(function(o,k){return{o:o,c:k==0}}));
 var h='<div class="hud"><span class="pill">Q '+(i+1)+'/'+pool.length+'</span><span class="pill">⭐ '+score+'</span><span class="pill">🔥 '+streak+'</span><button class="btn alt" id="hb" onclick="hint()" '+(hints?'':'disabled')+'>💡 50/50 ('+hints+')</button></div>';
 h+='<div class="bar"><i style="width:'+(i/pool.length*100)+'%"></i></div><div class="q">'+T[cur[0]].e+' '+cur[1]+'</div><div id="os">';
 opts.forEach(function(x,k){h+='<button class="opt" id="o'+k+'" onclick="pick('+k+')">'+x.o+'</button>'});
 A.innerHTML=h+'</div><div id="fb"></div>';
}
function hint(){
 if(locked||!hints)return;hints--;score=Math.max(0,score-30);
 var w=sh(opts.map(function(x,k){return k}).filter(function(k){return!opts[k].c})).slice(0,2);
 w.forEach(function(k){document.getElementById("o"+k).classList.add("gone")});
 document.getElementById("hb").disabled=true;
}
function pick(k){
 if(locked)return;locked=true;var ok=opts[k].c,t=cur[0];
 res[t]=res[t]||[0,0];res[t][1]++;
 var pts=0;
 if(ok){res[t][0]++;streak++;pts=100+Math.min(streak-1,5)*20;score+=pts}else{streak=0;miss.push(cur)}
 opts.forEach(function(x,j){var b=document.getElementById("o"+j);b.disabled=true;if(x.c)b.classList.add("ok");else if(j==k)b.classList.add("no")});
 var last=i==pool.length-1;
 document.getElementById("fb").innerHTML='<div class="fb pop '+(ok?'ok':'no')+'"><b>'+(ok?'Correct! +'+pts+(streak>2?' 🔥 streak x'+streak:''):'Not quite.')+'</b><br>'+cur[3]+'</div><button class="btn" onclick="nxt()">'+(last?'See my results':'Next question')+'</button>';
 document.getElementById("fb").scrollIntoView({block:"nearest",behavior:"smooth"});
}
function nxt(){i++;if(i<pool.length)ask();else done()}
function done(){
 var tot=0,ok=0;for(var t in res){ok+=res[t][0];tot+=res[t][1]}
 var pc=Math.round(ok/tot*100),key=mode<0?"all":mode,nb=score>(store[key]||0);
 if(nb){store[key]=score;sv()}
 var rank=pc>=90?"Periodic Table Legend 👑":pc>=75?"Lab Pro 🥼":pc>=60?"Getting There 🔬":"Time to Review 📚";
 var h='<h1>Round complete!</h1><div class="big">'+score+'</div><p class="sub">'+rank+' · '+ok+'/'+tot+' correct ('+pc+'%)'+(nb?' · 🎉 New best!':'')+'</p><h2>Topic scores</h2>';
 var weak=[];
 Object.keys(res).forEach(function(t){var p=Math.round(res[t][0]/res[t][1]*100);if(p<80)weak.push(+t);
  h+='<div class="tb"><span>'+T[t].e+' '+T[t].n+'</span><div class="bar"><i class="'+(p<80?'lo':'hi')+'" style="width:'+p+'%"></i></div><span>'+p+'%</span></div>'});
 if(weak.length){h+='<h2 style="margin-top:18px">How to study your weak spots</h2>';
  weak.forEach(function(t){h+='<div class="tip"><b>'+T[t].e+' '+T[t].n+'</b><br>'+T[t].tip.join('<br>')+'</div>'})}
 else h+='<div class="tip">Everything is above 80%. Next, rework old Schoology assignments and practice explaining the WHY out loud (nuclear charge, shielding, octet).</div>';
 if(miss.length){h+='<h2 style="margin-top:18px">Questions you missed</h2>';
  miss.forEach(function(q){h+='<div class="miss"><b>'+q[1]+'</b><br>Answer: '+q[2][0]+'<br><span style="color:var(--mu)">'+q[3]+'</span></div>'})}
 h+='<div class="row"><button class="btn" onclick="start('+mode+')">Play again</button><button class="btn alt" onclick="home()">Pick another round</button></div>';
 A.innerHTML=h;window.scrollTo(0,0);
}
